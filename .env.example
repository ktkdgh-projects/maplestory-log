# 키 이름만 적는다. 실제 값은 .env(로컬)와 Vercel 환경 변수에만 둔다.

# 로그인 없는 캐릭터 검색용 서버 키 (넥슨 Open API)
NUXT_NEXON_API_KEY=

# MongoDB Atlas 연결 문자열
NUXT_MONGO_URI=

# /api/cron/snapshot 호출용 Bearer 토큰
NUXT_CRON_SECRET=

# 사용자 API 키 암호화 시크릿 (AES-256-GCM, 32바이트). 로컬과 운영 값을 다르게
NUXT_KEY_ENC_SECRET=

# 키 중복 확인용 HMAC 시크릿
NUXT_KEY_HASH_SECRET=

# /admin 운영 페이지를 볼 수 있는 넥슨 계정 id (쉼표로 여러 개)
NUXT_ADMIN_ACCOUNT_IDS=
